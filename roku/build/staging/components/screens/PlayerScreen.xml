<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
    <interface>
        <field id="item" type="node" />
        <field id="seasons" type="array" />
        <field id="se" type="integer" />
        <field id="ep" type="integer" />
        <field id="resume" type="integer" />
        <field id="altMode" type="boolean" />
        <field id="start" type="boolean" alwaysNotify="true" onChange="onStart" />
        <field id="action" type="assocarray" alwaysNotify="true" />
        <field id="focusIn" type="boolean" alwaysNotify="true" onChange="onFocusIn" />
        <field id="refresh" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/lib/Utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/screens/PlayerScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Video id="video" width="1920" height="1080" enableUI="true" />
        <Group id="loading">
            <Poster id="loadingArt" width="1920" height="1080" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToZoom" opacity="0.3" />
            <Poster uri="pkg:/images/grad_bottom.png" width="1920" height="1080" />
            <Label id="loadingTitle" color="0xF2F4F8FF" translation="[0, 360]" width="1920" horizAlign="center" wrap="false">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="56" />
            </Label>
            <Label id="loadingSub" color="0x8A94A6FF" translation="[0, 436]" width="1920" horizAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="28" />
            </Label>
            <Spinner id="spinner" translation="[960, 620]" />
        </Group>
        <Group id="toast" visible="false" translation="[96, 80]">
            <Rectangle id="toastBg" color="0x0A0E14E6" height="64" />
            <Rectangle color="0xF5B82EFF" width="6" height="64" />
            <Label id="toastText" color="0xF2F4F8FF" translation="[28, 0]" height="64" vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="26" />
            </Label>
        </Group>
        <SelectDialog id="dialog" visible="false" />
        <Timer id="toastTimer" duration="3.5" repeat="false" />
    </children>
</component>
