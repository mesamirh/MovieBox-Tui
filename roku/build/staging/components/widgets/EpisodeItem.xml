<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodeItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="width" type="float" onChange="onContentChange" />
        <field id="height" type="float" onChange="onContentChange" />
        <field id="focusPercent" type="float" onChange="onFocusChange" />
        <field id="gridHasFocus" type="boolean" onChange="onFocusChange" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/widgets/EpisodeItem.brs" />
    <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
    <children>
        <Rectangle id="frame" color="0xF5B82EFF" opacity="0" />
        <Rectangle id="bg" color="0x161C26FF" />
        <Poster id="art" loadDisplayMode="scaleToZoom" opacity="0.28" />
        <Label id="number" color="0xF2F4F8FF" translation="[24, 14]">
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="56" />
        </Label>
        <Label id="title" color="0xC9D1DCFF" wrap="false">
            <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="24" />
        </Label>
        <Label id="status" color="0x8A94A6FF" wrap="false" horizAlign="right">
            <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="20" />
        </Label>
        <Rectangle id="track" color="0x00000099" height="6" visible="false" />
        <Rectangle id="fill" color="0xF5B82EFF" height="6" visible="false" />
    </children>
</component>
