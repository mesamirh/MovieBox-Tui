<?xml version="1.0" encoding="utf-8" ?>
<component name="ActionButton" extends="Group">
    <interface>
        <field id="text" type="string" onChange="layout" />
        <field id="primary" type="boolean" value="false" onChange="render" />
        <field id="highlighted" type="boolean" value="false" onChange="render" />
        <field id="buttonWidth" type="float" value="0" />
        <field id="actionId" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/widgets/ActionButton.brs" />
    <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
    <children>
        <Poster id="bg" uri="pkg:/images/pill.9.png" height="72" />
        <Label id="label" height="72" vertAlign="center" horizAlign="center">
            <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="28" />
        </Label>
    </children>
</component>
