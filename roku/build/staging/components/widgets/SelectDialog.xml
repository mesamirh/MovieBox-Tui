<?xml version="1.0" encoding="utf-8" ?>
<component name="SelectDialog" extends="Group">
    <interface>
        <field id="title" type="string" onChange="onTitleChange" />
        <field id="message" type="string" onChange="onTitleChange" />
        <field id="options" type="array" onChange="onOptionsChange" />
        <field id="currentIndex" type="integer" value="-1" onChange="onOptionsChange" />
        <field id="selected" type="integer" alwaysNotify="true" />
        <field id="dismissed" type="boolean" alwaysNotify="true" />
        <field id="tag" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/widgets/SelectDialog.brs" />
    <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
    <children>
        <Rectangle id="scrim" width="1920" height="1080" color="0x000000C8" />
        <Group id="panel">
            <Rectangle id="panelBg" color="0x161C26FF" width="820" />
            <Rectangle id="accentBar" color="0xF5B82EFF" width="820" height="6" />
            <Label id="titleLabel" color="0xF2F4F8FF" translation="[56, 48]" width="708" wrap="true">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="40" />
            </Label>
            <Label id="messageLabel" color="0x8A94A6FF" translation="[56, 108]" width="708" wrap="true" maxLines="4">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="26" />
            </Label>
            <LabelList id="list" translation="[40, 170]" itemSize="[740, 72]" itemSpacing="[0, 8]" numRows="7" vertFocusAnimationStyle="floatingFocus" focusBitmapUri="pkg:/images/pill.9.png" focusFootprintBitmapUri="pkg:/images/pill.9.png" focusFootprintBlendColor="0xFFFFFF1A" focusBitmapBlendColor="0xF5B82EFF" color="0xC9D1DCFF" focusedColor="0x0A0E14FF" textHorizAlign="left">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="28" />
                <Font role="focusedFont" uri="pkg:/fonts/Inter-SemiBold.ttf" size="28" />
            </LabelList>
            <Label id="hint" color="0x5A6476FF" width="708" horizAlign="center" text="OK to select    •    BACK to close">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="20" />
            </Label>
        </Group>
    </children>
</component>
