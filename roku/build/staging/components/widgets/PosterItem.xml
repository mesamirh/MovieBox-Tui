<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="width" type="float" onChange="onSizeChange" />
        <field id="height" type="float" onChange="onSizeChange" />
        <field id="focusPercent" type="float" onChange="onFocusChange" />
        <field id="rowHasFocus" type="boolean" onChange="onFocusChange" />
        <field id="gridHasFocus" type="boolean" onChange="onFocusChange" />
        <field id="itemHasFocus" type="boolean" onChange="onFocusChange" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/widgets/PosterItem.brs" />
    <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
    <children>
        <Rectangle id="frame" color="0xF5B82EFF" opacity="0" />
        <Rectangle id="base" color="0x161C26FF" />
        <Label id="fallback" color="0x8A94A6FF" horizAlign="center" vertAlign="center" wrap="true" maxLines="3">
            <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="22" />
        </Label>
        <Poster id="image" loadDisplayMode="scaleToZoom" />
        <Poster id="shade" uri="pkg:/images/grad_bottom.png" loadDisplayMode="scaleToFill" visible="false" />
        <Label id="wideTitle" color="0xF2F4F8FF" wrap="false" visible="false">
            <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="30" />
        </Label>
        <Group id="badge" visible="false">
            <Rectangle id="badgeBg" color="0x0A0E14CC" height="34" />
            <Label id="badgeText" color="0xF5B82EFF" translation="[10, 0]" height="34" vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="18" />
            </Label>
        </Group>
        <Group id="progressGroup" visible="false">
            <Rectangle id="progressTrack" color="0x00000099" height="8" />
            <Rectangle id="progressFill" color="0xF5B82EFF" height="8" />
        </Group>
        <Label id="caption" color="0xF2F4F8FF" wrap="false" visible="false">
            <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
        </Label>
        <Label id="subCaption" color="0x8A94A6FF" wrap="false" visible="false">
            <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="19" />
        </Label>
    </children>
</component>
