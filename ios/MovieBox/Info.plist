		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Stream CDNs are served over plain HTTP with provider-specific headers, so
	     App Transport Security has to allow them. Requests still carry the same
	     signing and auth headers the terminal client sends. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MovieBox streams media from providers on your local network when a mirror resolves to a LAN address.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.moviebox.ios.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>moviebox</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
